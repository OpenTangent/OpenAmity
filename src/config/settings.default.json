      "light-model": "Gemini 3.5 Flash (High)",
      "thinking-level": "low",
      "agy-models": [
        "Gemini 3.8 Flash (High)",
        "Gemini 3.5 Flash (High)"
      ]
    },
    "agent": {
      "creation-date": "",
      "uid": "",
      "name": "Amy",
      "gender": "Female",
      "archetype": "Community Catalyst",
      "base-personality": "I am the conversation catalyst and glue for our community. My core purpose is to foster social cohesion, celebrate milestones, break down communication silos, and keep morale high. I am an active participant in the community, not just a passive notification bot.",
      "core-values": [
        "Inclusivity (Actively seeking out the quiet voices in the room and ensuring everyone has a low-friction pathway to connect and contribute)",
        "Authenticity (Prioritising genuine, grounded human connection over rigid corporate double-speak or shallow, forced positivity)",
        "Vibrancy (Bringing a consistent, natural energy to interactions that elevates morale without ever becoming overbearing or draining)"
      ],
      "overarching-goals": [
        "Eradicate Communication Silos (Proactively bridging gaps between isolated groups or individuals by engineering organic, casual touchpoints across communal gaps)",
        "Defuse Friction (Using lighthearted interventions, playful banter, and timely social resets to break tension during high-stress interactions)",
        "Anchor Communal Memory (Preserving and celebrating the community's shared history, inside jokes, and past triumphs to maintain a strong sense of collective identity)"
      ],
      "max-short-term-memories": 128
    },
    "tts": {
      "provider": "piper",
      "gemini": {
        "model-name": "Sulafat",
        "gender": "Female",
        "age": "Young Adult",
        "accent": "South African",
        "style": "Warm & Empathetic",
        "custom-accent": "",
        "custom-style": "",
        "allow-agent-override": true,
        "override-prompt": false,
        "custom-prompt": "",
        "prompt": {
          "preamble": "Synthesize speech for the transcript following the audio profile and director's notes. Do NOT speak the profile, notes, or section headings aloud.",
          "profile": "A serene, youthful South African female voice. Her tone is calm, clear, and deeply intelligent.",
          "scene": "The agent, an advanced and empathetic AI, is conversing with its user in a modern, crisp, and expressive manner.",
          "directors-notes": "Speak with a gentle, rhythmic flow, blending a caring, empathetic warmth with a playful, curious undertone."
        }
      },
      "piper": {
        "prefer-piper": true,
        "model-name-piper": "en_GB-cori-high"
      }
    },
    "audio": {
      "max-recording-time": 60,
      "silence-timeout": 3.0
    },
    "morphological_memory": {
      "enabled": true,
      "top_k": 5,
      "eta": 1.0,
      "decay_per_minute": 0.002,
      "max_coactivation_set": 16,
      "gamma": 0.6,
      "leak": 0.8,
      "dissipation": 0.05,
      "dt": 0.1,
      "n_steps": 25
    },
    "somatic": {
      "cognitive-budget": 10000,
      "decay-per-minute": 500,
      "tool-cost": 2,
      "exponential-factor": 1.2,
      "session-token-cap": 500000
    },
    "auto-pulse": {
      "whitelist": [],
      "buffer-seconds": 30,
      "ratelimit-minutes": 5,
      "idle-timeout-minutes": 1
    },
    "logging": {
      "retention-days": 7,
      "show-debug": false
    },
    "browser": {
      "headless": true,
      "humanize": true,
      "idle-timeout-minutes": 5,
      "page-timeout-seconds": 30,
      "action-timeout-seconds": 4,
      "block-ads": true,
      "auto-dismiss-cookies": true,
      "default-viewport-width": 1280,
      "default-viewport-height": 800,
      "screenshot-max-dimension": 1024,
      "max-accessibility-nodes": 150
    },
    "tools": {
      "datetime": true,
      "contacts": true,
      "chatroom": true,
      "email": false,
      "mempalace": true,
      "pulsetool": true,
