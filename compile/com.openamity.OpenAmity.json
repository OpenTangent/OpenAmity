{
    "app-id": "com.openamity.OpenAmity",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "base": "io.qt.PySide.BaseApp",
    "base-version": "6.11",
    "command": "run_OpenAmity.sh",
    "finish-args": [
        "--share=network",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--device=all",
        "--filesystem=xdg-download",
        "--filesystem=xdg-documents",
        "--filesystem=xdg-pictures",
        "--filesystem=xdg-desktop"
    ],
    "modules": [
        {
            "name": "portaudio",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/PortAudio/portaudio.git",
                    "tag": "v19.7.0",
                    "commit": "147dd722548358763a8b649b3e4b41dfffbcfbb6"
                }
            ]
        },
        "python3-requirements.json",
        {
            "name": "nodejs",
            "buildsystem": "simple",
            "build-commands": [
                "cp -a * /app/"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://nodejs.org/dist/v24.21.0/node-v24.21.0-linux-x64.tar.xz",
                    "sha256": "fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6"
                }
            ]
        },
        {
            "name": "puppeteer-chromium",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /app/share/puppeteer/chrome-linux64",
                "cp -a * /app/share/puppeteer/chrome-linux64/",
                "chmod -R 755 /app/share/puppeteer/chrome-linux64"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://storage.googleapis.com/chrome-for-testing-public/153.0.8010.36/linux64/chrome-linux64.zip",
                    "sha256": "167a098c4fdec156b58a9f678c90a84f9072d789f9c6e7b35496a6987b8b7ef8"
                }
            ]
        },
        {
            "name": "camoufox",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /app/share/camoufox",
                "cp -a * /app/share/camoufox/",
                "chmod -R 755 /app/share/camoufox"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/daijro/camoufox/releases/download/v152.0.4-beta.30/camoufox-152.0.4-beta.30-lin.x86_64.zip",
                    "sha256": "5720d45b894ce1770543de024c6f10d514b38be560fa2dc3226b3d8586caf672"
                }
            ]
        },
        {
            "name": "chroma-onnx-model",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /app/share/chroma_onnx/all-MiniLM-L6-v2",
                "cp onnx.tar.gz /app/share/chroma_onnx/all-MiniLM-L6-v2/onnx.tar.gz"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://chroma-onnx-models.s3.amazonaws.com/all-MiniLM-L6-v2/onnx.tar.gz",
                    "sha256": "913d7300ceae3b2dbc2c50d1de4baacab4be7b9380491c27fab7418616a16ec3"
                }
            ]
        },
        {
            "name": "open_amity",
            "buildsystem": "simple",
            "build-commands": [
                "install -D compile/com.openamity.OpenAmity.desktop /app/share/applications/com.openamity.OpenAmity.desktop",
                "install -D compile/com.openamity.OpenAmity.metainfo.xml /app/share/metainfo/com.openamity.OpenAmity.metainfo.xml",
                "install -D src/assets/com.openamity.OpenAmity.png /app/share/icons/hicolor/512x512/apps/com.openamity.OpenAmity.png",
                "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true PUPPETEER_SKIP_DOWNLOAD=true npm --prefix src/tools/whatsapp_node --cache flatpak-node/npm-cache --prefer-offline --no-audit --no-fund ci",
                "cp -r src /app/src",
                "cp run_OpenAmity.sh /app/bin/run_OpenAmity.sh",
                "chmod +x /app/bin/run_OpenAmity.sh"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": ".."
                },
                "node-sources.json"
            ]
        }
    ]
}